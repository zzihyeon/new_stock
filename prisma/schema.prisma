generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Timeframe {
  DAY
  MINUTE
}

model Stock {
  symbol    String   @id @db.VarChar(12)
  name      String   @db.VarChar(120)
  market    String   @db.VarChar(16)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  candles        Candle[]
  watchlistItems WatchlistItem[]
}

model Candle {
  id         BigInt    @id @default(autoincrement())
  symbol     String    @db.VarChar(12)
  timeframe  Timeframe
  baseDate   String    @db.VarChar(8)
  baseTime   String    @db.VarChar(6)
  open       Int
  high       Int
  low        Int
  close      Int
  volume     BigInt
  tradeValue BigInt?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  stock Stock @relation(fields: [symbol], references: [symbol], onDelete: Cascade)

  @@index([symbol, timeframe, baseDate(sort: Desc), baseTime(sort: Desc)])
  @@unique([symbol, timeframe, baseDate, baseTime])
}

model WatchlistItem {
  id          BigInt    @id @default(autoincrement())
  symbol      String    @db.VarChar(12)
  memo        String?
  targetPrice Int?
  stopPrice   Int?
  enabled     Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  stock Stock @relation(fields: [symbol], references: [symbol], onDelete: Cascade)

  @@index([symbol])
}

model BacktestRun {
  id             BigInt   @id @default(autoincrement())
  symbol         String   @db.VarChar(12)
  timeframe      Timeframe
  fromDate       String   @db.VarChar(8)
  toDate         String   @db.VarChar(8)
  ruleName       String   @db.VarChar(40)
  initialCapital Float
  finalCapital   Float
  totalReturnPct Float
  maxDrawdownPct Float
  trades         Int
  summary        Json?
  createdAt      DateTime @default(now())

  @@index([symbol, createdAt(sort: Desc)])
}
